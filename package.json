{
  "name": "project-manage",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 0.0.0.0\" \"tsx watch src/server/index.ts\"",
    "dev:web": "vite --host 0.0.0.0",
    "dev:server": "tsx watch src/server/index.ts",
    "build": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit && vite build && tsup src/server/index.ts --format esm --platform node --out-dir dist-server --external better-sqlite3",
    "start": "node dist-server/index.js",
    "db:generate": "drizzle-kit generate",
    "test": "vitest run",
    "test:responsive": "playwright test --config playwright.config.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@dnd-kit/core": "latest",
    "@fastify/cookie": "latest",
    "@fastify/rate-limit": "latest",
    "@fastify/static": "latest",
    "@modelcontextprotocol/node": "latest",
    "@modelcontextprotocol/server": "latest",
    "@tanstack/react-query": "latest",
    "better-sqlite3": "latest",
    "date-fns": "latest",
    "dotenv": "latest",
    "drizzle-orm": "latest",
    "echarts": "latest",
    "fastify": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/better-sqlite3": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "drizzle-kit": "latest",
    "tsup": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest"
  }
}
