{
  "name": "project-manage",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 0.0.0.0\" \"tsx watch src/server/index.ts\"",
    "dev:web": "vite --host 0.0.0.0",
    "dev:server": "tsx watch src/server/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "eslint .",
    "check:runtime": "node scripts/check-runtime.mjs",
    "build": "npm run typecheck && vite build && tsup src/server/index.ts --format esm --platform node --out-dir dist-server --external better-sqlite3",
    "build:test-ui": "npm run typecheck && vite build --outDir .playwright/dist && tsup src/server/index.ts --format esm --platform node --out-dir .playwright/server --external better-sqlite3",
    "start": "node dist-server/index.js",
    "db:generate": "drizzle-kit generate",
    "test": "vitest run",
    "test:responsive": "playwright test --config playwright.config.ts",
    "test:watch": "vitest",
    "verify": "npm run check:runtime && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@fastify/cookie": "11.1.2",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.3",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@tanstack/react-query": "5.102.8",
    "better-sqlite3": "13.0.3",
    "chinese-days": "1.5.9",
    "date-fns": "4.4.0",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "echarts": "6.1.0",
    "fastify": "5.12.1",
    "lucide-react": "1.38.0",
    "pinyin-pro": "3.29.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@typescript/native": "npm:typescript@7.0.2",
    "@playwright/test": "1.62.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "drizzle-kit": "0.31.10",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "tsup": "8.5.1",
    "tsx": "4.23.13",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
