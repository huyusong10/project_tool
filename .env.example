HOST=0.0.0.0
PORT=3210
DB_PATH=./data/project-manage.db
BACKUP_DIR=./data/backups
# 可填写便于记忆的 admin 密码（至少10位）；首次初始化和导入数据库时使用。
# 非空时优先于 APP_PASSWORD_HASH；不要将填写后的 .env 提交到 Git。
ADMIN_PASSWORD=
APP_PASSWORD_HASH=scrypt$replace-with-configure-script
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_HOURS=12
SESSION_COOKIE_NAME=pm_session
HIGH_RISK_DELAY_DAYS=3
BACKUP_RETENTION_DAYS=30
BACKUP_MAX_COUNT=100
DATABASE_IMPORT_MAX_MB=512
SEED_DEMO=1
